{
  "name": "@loom/cli",
  "version": "0.0.1",
  "type": "module",
  "bin": {
    "loom": "dist/loom.cjs"
  },
  "scripts": {
    "build": "esbuild src/loom.ts --bundle --platform=node --target=node22 --format=cjs --external:falkordb --external:web-tree-sitter --external:tree-sitter-wasms --define:import.meta.url=undefined --banner:js=\"#!/usr/bin/env node\" --outfile=dist/loom.cjs && chmod +x dist/loom.cjs"
  },
  "dependencies": {
    "@loom/core": "workspace:*",
    "@loom/daemon": "workspace:*",
    "@loom/planner": "workspace:*",
    "falkordb": "6.8.0",
    "tree-sitter-wasms": "0.1.13",
    "web-tree-sitter": "0.22.6",
    "@loom/indexer": "workspace:*",
    "@loom/memory": "workspace:*"
  }
}
