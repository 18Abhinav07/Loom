{
  "name": "loom",
  "private": true,
  "packageManager": "pnpm@9.15.0",
  "scripts": {
    "test": "vitest run && vitest run -c vitest.perf.config.ts",
    "build:hook": "pnpm --filter @loom/hook build",
    "build:mcp": "pnpm --filter @loom/mcp build",
    "daemon": "pnpm --filter @loom/daemon start",
    "build:cli": "pnpm --filter @loom/cli build",
    "build:ui": "pnpm --filter dashboard build"
  },
  "devDependencies": {
    "@testing-library/dom": "10.4.0",
    "@testing-library/react": "16.3.0",
    "@types/node": "22.10.1",
    "esbuild": "0.24.0",
    "jsdom": "26.1.0",
    "tsx": "4.19.2",
    "typescript": "5.6.3",
    "vitest": "2.1.8"
  }
}
